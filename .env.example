# ==============================================================================
# CareerPath AI — Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO .env.local AND POPULATE WITH YOUR ACTUAL KEYS:
# cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# DO NOT COMMIT .env.local OR ANY ACTUAL PRODUCTION KEYS TO VERSION CONTROL!
# All sensitive variables are automatically ignored via .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Server-Side JWT Secret (Required in production: use 32+ characters random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-random-32-char-minimum-jwt-secret-key-goes-here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Optional for local test/dev: if omitted or unreachable, CareerPath AI automatically
# falls back to its deterministic high-performance in-memory persistence engine.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careerpath_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AI / LLM MULTI-PROVIDER ORCHESTRATION
# ------------------------------------------------------------------------------
# Provider options: 'gemini' | 'openai' | 'groq' | 'auto' | 'offline'
# If keys are omitted, the system seamlessly falls back to offline deterministic logic.
AI_PROVIDER=auto

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (Optional failover, get at: https://platform.openai.com/)
OPENAI_API_KEY=your-openai-api-key-here

# Groq Cloud API Key (Optional ultra-fast inference, get at: https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION (CLIENT-SIDE)
# ------------------------------------------------------------------------------
# Create project at: https://console.firebase.google.com/
# Enable Authentication -> Sign-in methods: Email/Password, Google OAuth, GitHub
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-hex-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-MEASUREMENTID
